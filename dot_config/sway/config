### Autostart

exec_always sh -c 'pkill waybar; waybar'
exec_always sh -c 'pkill mako; mako'
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
exec wlsunset -S 07:00 -s 23:30 -t 4000 -T 6500 # starting 23:30 and ending 07:00
# exec_always sh -c 'pkill wob; pkill -f "tail -f /tmp/wob.sock"; rm -f /tmp/wob.sock; mkfifo /tmp/wob.sock; tail -f /tmp/wob.sock | wob -c "$HOME/.config/wob/wob.ini"' # volume/brightness feedback
exec_always sh -c 'pkill swayosd-server; swayosd-server'

exec nm-applet

